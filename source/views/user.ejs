<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <title><%= profileUser.nickname %></title>
</head>
<body>
<%- include('includes/header.ejs') %>

<h1>
  <img src="<%= profileUser.avatar_path || '/static/default-avatar.jpg' %>"
       alt="avatar" width="64" height="64">
  <%= profileUser.nickname %>
</h1>

<% if (profileUser.status) { %>
  <p><em><%= profileUser.status %></em></p>
<% } %>

<%# --- Кнопки действий в зависимости от контекста --- %>

<% if (isSelf) { %>
  <p><strong>Это ваша страница</strong></p>
<% } else if (locals.user) { %>
  <% if (isFriend) { %>
    <form action="/user/<%= profileUser.user_id %>/unfriend"
          method="post" style="display:inline">
      <button type="submit">Удалить из друзей</button>
    </form>
  <% } else { %>
    <form action="/user/<%= profileUser.user_id %>/friend"
          method="post" style="display:inline">
      <button type="submit">Добавить в друзья</button>
    </form>
  <% } %>
<% } else { %>
  <p><a href="/auth/login">Войдите</a>, чтобы добавить в друзья</p>
<% } %>

<%# --- Форма создания поста (только на своей странице) --- %>

<% if (isSelf) { %>
  <h2>Новый пост</h2>
  <form action="/user/<%= profileUser.user_id %>/post" method="post">
    <p>
      <textarea name="text" rows="4" cols="60"
                placeholder="Что нового?"
                required maxlength="5000"></textarea>
    </p>
    <p>
      <button type="submit">Опубликовать</button>
    </p>
  </form>
<% } %>

<h2>Посты</h2>

<% if (posts.length === 0) { %>
  <p>Постов нет</p>
<% } else { %>
  <% for (const post of posts) { %>
    <%- include('includes/post.ejs', { post }) %>
  <% } %>
<% } %>

</body>
</html>