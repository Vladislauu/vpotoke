<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <title>Сообщения</title>
  <link rel="stylesheet" href="/static/styles/convIndex.css">
</head>
<body>
<%- include('includes/header.ejs') %>

<h1>Сообщения</h1>
<p><a href="/conv/create">+ Создать беседу</a></p>

<div class="messenger" data-my-id="<%= locals.myUserId ?? 0 %>">
  <%# ─────────── Левая колонка: чаты ─────────── %>
  <aside class="chats">
    <% if (convs.length === 0) { %>
      <p style="padding: 8px;">Нет бесед</p>
    <% } %>
    <% for (const c of convs) { %>
      <a class="chat-item <%= (activeConv && activeConv.conv_id === c.conv_id) ? 'active' : '' %>"
         href="/conv/<%= c.conv_id %>">
        <img src="<%= c.conv_avatar || '/static/default-conv.png' %>"
             width="32" height="32" alt="">
        <span><%= c.conv_name %></span>
      </a>
    <% } %>
  </aside>

  <%# ─────────── Центр: диалог ─────────── %>
  <section class="dialog"
           <% if (activeConv) { %>data-conv-id="<%= activeConv.conv_id %>"<% } %>>
    <% if (!activeConv) { %>
      <p style="padding: 8px;">Выберите беседу слева</p>
    <% } else { %>
      <h2>
        <%= activeConv.conv_name %>
        <small id="typing-indicator" class="typing-indicator"></small>
      </h2>

      <div class="messages" id="messages">
        <% if (messages.length === 0) { %>
          <p id="no-messages">Сообщений пока нет</p>
        <% } %>
        <% for (const m of messages) { %>
          <div class="message" data-msg-id="<%= m.msg_id %>">
            <span class="author"><%= m.user.nickname %>:</span>
            <span class="text"><%= m.text %></span>
            <small><%= new Date(m.sent).toLocaleString('ru-RU') %></small>
          </div>
        <% } %>
      </div>

      <form class="message-form" id="message-form">
        <input type="text" name="text" id="message-input"
               placeholder="Сообщение..."
               autocomplete="off" required>
        <button type="submit">Отправить</button>
      </form>
    <% } %>
  </section>

  <%# ─────────── Правая колонка: участники ─────────── %>
  <% if (activeConv) { %>
    <aside class="members">
      <h3>Участники</h3>

      <% for (const m of members) { %>
        <div class="member" data-member-id="<%= m.user_id %>">
          <img src="<%= m.user.avatar_path || '/static/default-avatar.png' %>"
               width="24" height="24" alt="">
          <span class="name"><%= m.user.nickname %></span>

          <span class="online-dot" title="не в сети"></span>

          <% if (isAdmin && m.user_id !== myUserId) { %>
            <form class="role-form"
                  action="/conv/<%= activeConv.conv_id %>/member/<%= m.user_id %>/role"
                  method="post">
              <select name="role_id">
                <% for (const r of roles) { %>
                  <option value="<%= r.role_id %>"
                          <%= r.role_id === m.role_id ? 'selected' : '' %>>
                    <%= r.name %>
                  </option>
                <% } %>
              </select>
              <button type="submit" title="Применить роль">✓</button>
            </form>

            <form action="/conv/<%= activeConv.conv_id %>/member/<%= m.user_id %>/kick"
                  method="post" class="kick-form">
              <button type="submit" title="Исключить из беседы">✕</button>
            </form>
          <% } else { %>
            <span class="role"><%= m.role?.name || '—' %></span>
          <% } %>
        </div>
      <% } %>

      <div class="leave-wrap">
        <form action="/conv/<%= activeConv.conv_id %>/leave" method="post">
          <button type="submit" class="btn-danger">Покинуть беседу</button>
        </form>
      </div>
    </aside>
  <% } %>
</div>

<%# ─── Скрипты: сокет-клиент и наш модуль ─── %>
<script src="/socket.io/socket.io.js"></script>
<script src="/static/scripts/conv.js" defer></script>

</body>
</html>